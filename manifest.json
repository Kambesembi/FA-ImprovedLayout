{
  "manifest_version": 3,
  "name": "FA Ultrawide",
  "version": "1.19.0",
  "description": "Centered wide layout for Fur Affinity (modern theme) with quick view, comic reader and infinite scroll.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.furaffinity.net/*"
      ],
      "css": [
        "ultrawide.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.furaffinity.net/*"
      ],
      "css": [
        "features.css"
      ],
      "js": [
        "i18n.js",
        "features.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FA Ultrawide",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}